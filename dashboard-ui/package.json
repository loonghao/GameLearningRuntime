{
  "name": "glr-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/fingerprint.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src scripts *.json *.ts index.html",
    "format": "prettier --write src scripts *.json *.ts index.html"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.46.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
