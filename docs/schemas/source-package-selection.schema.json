{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glr.source-package-selection.v1",
  "title": "GLR source package selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_version",
    "required_glr",
    "environment_id",
    "protocol_version",
    "contract_sha256",
    "source_revision",
    "redistribution_license",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "glr.source-package.v1"
    },
    "package_version": {
      "type": "string"
    },
    "required_glr": {
      "type": "string"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "redistribution_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  }
}
